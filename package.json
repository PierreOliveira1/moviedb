{
	"name": "moviedb",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"start": "vite preview --outDir build/client",
		"preview": "vite preview --outDir build/client",
		"prepare": "husky",
		"typecheck": "react-router typegen && tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"validate": "pnpm check && pnpm typecheck && pnpm test --runInBand && pnpm build"
	},
	"dependencies": {
		"@react-router/node": "^7.12.0",
		"@tanstack/react-query": "^5.90.21",
		"isbot": "^5.1.35",
		"lucide-react": "^0.563.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@jest/globals": "^30.2.0",
		"@react-router/dev": "^7.12.0",
		"@react-router/fs-routes": "^7.12.0",
		"@swc/core": "^1.15.11",
		"@swc/jest": "^0.2.39",
		"@tailwindcss/vite": "^4.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"msw": "^2.12.7",
		"tailwindcss": "^4.2.0",
		"typescript": "~6.0.2",
		"undici": "^7.16.0",
		"vite": "^8.1.1"
	}
}
